# --- server ---
PORT=8080
DB_PATH=./data/wisemapping.db
LOG_LEVEL=info

# --- auth ---
# REQUIRED. Base64-encoded HMAC key (the value is base64-decoded before use,
# matching the Java JwtTokenUtil). Generate one with:
#   openssl rand -base64 48
# The server refuses to start if this is unset. There is deliberately no default.
JWT_SECRET=
JWT_EXPIRATION_MIN=10080

# Admin is a single configured email address (matching app.admin.user in the
# Java app). Leave empty to mean "no admin exists".
ADMIN_EMAIL=

# --- site ---
UI_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- registration ---
REGISTRATION_ENABLED=true
# No mailer is in scope; when true, activation URLs are logged to stdout.
EMAIL_CONFIRMATION_ENABLED=false
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=

# --- limits (mirroring app.mindmap.* in the Java app) ---
MAP_LIST_MAX_SIZE=500
NOTE_MAX_LENGTH=10000

# --- misc ---
ANALYTICS_ACCOUNT=
